<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WeathersnakeAvalonia.ViewModels"
        xmlns:models="using:WeathersnakeAvalonia.Models"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        Title="Weather Juice v1.0.23"
        Width="1100"
        Height="700"
        Icon="avares://WeathersnakeAvalonia/Assets/logo.ico"
        x:Class="WeathersnakeAvalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel">

    <Window.Styles>
        <Style Selector="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Margin" Value="0,0,15,0"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Padding" Value="15,5"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="15">
        <!-- Settings Panel -->
        <Border Grid.Row="0" Padding="15" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" CornerRadius="8" Margin="0,0,0,10">
            <StackPanel>
                <!-- Row 0: Main controls -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                        <Label Content="Location:" Target="locationCb"/>
                        <ComboBox x:Name="locationCb" Width="150" SelectedItem="{Binding SelectedLocation}" ItemsSource="{Binding LocationPresets}"/>
                        <TextBox Width="120" Text="{Binding CustomCityInput}" IsVisible="{Binding ShowCustomCityInput}" Watermark="Enter city name..."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                        <Label Content="Period:" Target="periodCb"/>
                        <ComboBox x:Name="periodCb" Width="120" SelectedItem="{Binding SelectedPeriod}" ItemsSource="{Binding PeriodOptions}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                        <Label Content="Depth (Years):"/>
                        <ComboBox Width="60" SelectedItem="{Binding SelectedDepth}" ItemsSource="{Binding DepthOptions}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                        <Label Content="Units:"/>
                        <ComboBox Width="80" SelectedItem="{Binding SelectedUnits}" ItemsSource="{Binding UnitOptions}"/>
                    </StackPanel>

                    <CheckBox Content="Monthly Average" IsChecked="{Binding MonthlyAverage}"/>
                    <CheckBox Content="Rain Only" IsChecked="{Binding RainOnly}"/>
                    <CheckBox Content="Shared Y-Axis" IsChecked="{Binding SharedYAxis}"/>
                </WrapPanel>

                <!-- Row 1: Conditional controls -->
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowCustomRange}" Margin="0,0,0,10">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="50" SelectedItem="{Binding CustomStartDay}" ItemsSource="{Binding DayValues}"/>
                    <ComboBox Width="60" SelectedItem="{Binding CustomStartMonth}" ItemsSource="{Binding MonthNames}"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <ComboBox Width="50" SelectedItem="{Binding CustomEndDay}" ItemsSource="{Binding DayValues}"/>
                    <ComboBox Width="60" SelectedItem="{Binding CustomEndMonth}" ItemsSource="{Binding MonthNames}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowMonthSelector}" Margin="0,0,0,10">
                    <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox Width="70" SelectedItem="{Binding SelectedMonth}" ItemsSource="{Binding MonthNames}"/>
                </StackPanel>

                <!-- Row 2: Actions and status -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Min Precip (mm):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <NumericUpDown Value="{Binding PrecipThreshold}" Minimum="0" Maximum="50" Increment="0.5" Width="100"/>
                    </StackPanel>

                    <Button Content="Fetch Data" Command="{Binding FetchDataCommand}" IsEnabled="{Binding !IsLoading}"/>
                    <Button Content="Save to JPG" Command="{Binding SaveChartCommand}" IsEnabled="{Binding CanSave}"/>

                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="Gray"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="350,*">
            <!-- Left: Data Grid -->
            <Border Grid.Column="0" Padding="10" Margin="0,0,10,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Weather Data" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding WeatherResults}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:ProcessedWeatherData">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} | {1:F1} | {2:F1} | {3:F1}">
                                            <Binding Path="DateLabel"/>
                                            <Binding Path="TempMax"/>
                                            <Binding Path="TempMin"/>
                                            <Binding Path="PrecipSum"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Chart -->
            <Border Grid.Column="1" Padding="10">
                <Panel>
                    <TextBlock Text="Click Fetch Data to generate chart" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" IsVisible="{Binding !CanSave}"/>
                    <lvc:CartesianChart Series="{Binding ChartSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" IsVisible="{Binding CanSave}"/>
                </Panel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Padding="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="Gray"/>
        </Border>
    </Grid>
</Window>